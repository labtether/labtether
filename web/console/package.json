{
  "name": "labtether-console",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/console-runtime.mjs ./node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node scripts/console-runtime.mjs ./node_modules/next/dist/bin/next start",
    "lint": "npm run lint:types && npm run lint:ui",
    "tsc": "tsc",
    "lint:types": "npm run -s tsc -- --noEmit",
    "lint:ui": "eslint .",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:e2e:https": "env -u NO_COLOR PLAYWRIGHT_SELF_SIGNED_HTTPS=1 playwright test",
    "test": "vitest run",
    "test:runtime-proxy:standalone": "node scripts/test-runtime-proxy-standalone.mjs",
    "test:watch": "vitest",
    "test:visual:https": "env -u NO_COLOR PLAYWRIGHT_SELF_SIGNED_HTTPS=1 playwright test e2e/visual-regression.spec.ts",
    "postinstall": "sh scripts/patch-novnc.sh"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.13": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "flatted": "^3.4.4",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.29",
    "sharp": "0.35.5",
    "undici": "8.11.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@novnc/novnc": "^1.7.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@spice-project/spice-html5": "^0.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "cmdk": "^1.1.1",
    "guacamole-common-js": "^1.5.0",
    "lucide-react": "^1.54.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=26.11.1 <27",
    "npm": ">=12.2.0 <13"
  }
}
