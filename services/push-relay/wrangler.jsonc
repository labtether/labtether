{
  // LabTether push relay. Deploy steps and the API are in README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "labtether-push-relay",
  "main": "src/worker.js",
  // The Watari business Cloudflare account.
  "account_id": "62f3a7e24e93220b32c39058daf55cbf",
  // Not newer than the workerd (1.20261019.1) bundled with the pinned wrangler 4.151.2.
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  // Re-enter this Worker's public handler for the signed Apple connection.
  "compatibility_flags": ["global_fetch_strictly_public"],

  // Custom domain. labtether.com is a zone on this account (it serves the
  // website Worker), so `wrangler deploy` creates the DNS record and the
  // certificate. Hubs default to https://push.labtether.com. workers_dev stays
  // on for DEBUG iOS builds and for checks before the domain is live.
  "routes": [{ "pattern": "push.labtether.com", "custom_domain": true }],

  // Registration store, made with
  //   npx wrangler kv namespace create REGISTRATIONS
  "kv_namespaces": [
    { "binding": "REGISTRATIONS", "id": "5bec63183a7d401e86019b8017f1991b" }
  ],

  // Workers rate limiting. Counters are per Cloudflare location and
  // approximate. namespace_id only has to be unique within the account.
  "ratelimits": [
    // Per registration (keyed by the SHA-256 of its id).
    { "name": "PUSH_LIMIT", "namespace_id": "4801", "simple": { "limit": 60, "period": 60 } },
    // Per client IP (IPv6 grouped by /64) for register and delete.
    { "name": "REGISTER_LIMIT", "namespace_id": "4802", "simple": { "limit": 20, "period": 60 } },
    // Per client IP (IPv6 grouped by /64) for pushes. Checked before the KV
    // lookup, so probing random registration ids is bounded per caller.
    { "name": "PUSH_IP_LIMIT", "namespace_id": "4803", "simple": { "limit": 300, "period": 60 } }
  ],

  "vars": {
    // Same Worker, separate HTTP request context. Keep workers_dev enabled.
    "APNS_EGRESS_ORIGIN": "https://labtether-push-relay.hidden-glade-95d2.workers.dev",
    "APNS_TOPIC": "com.labtether.mobile",
    // 10-character Apple Team ID and APNs Key ID (not secret). Pushes answer
    // 503 not_configured while either is empty or the key secret is missing.
    "APNS_TEAM_ID": "D2WZW3YTL6",
    "APNS_KEY_ID": "TX94565GPN"
  },
  // Secret, never in this file or the repo. The owner uploads the .p8 personally:
  //   npx wrangler secret put APNS_PRIVATE_KEY < AuthKey_XXXXXXXXXX.p8
  // Separate 256-bit HMAC secret for the internal hop:
  //   openssl rand -hex 32 | npx wrangler secret put APNS_EGRESS_SECRET

  "observability": {
    "enabled": true,
    // Invocation logs record request URLs, and DELETE /v1/registrations/:id
    // carries a registration id. Keep them off; the code logs no secrets.
    "logs": { "invocation_logs": false }
  }
}
